---
import Base from '../../layouts/Base.astro';
import { ANIMALS, ANIMAL_BRANCH, THEME_KEY, byIssueDate, getVisibleCatalog } from '../../lib/catalog';

const base = import.meta.env.BASE_URL;
const issues = (await getVisibleCatalog()).sort(byIssueDate);

// 生肖軸顯示用篆書字形:蛇/狗/豬 採《說文》本字 它/犬/豕(分類/地支仍用原字)。
const SEAL_CHAR: Record<string, string> = { 蛇: '它', 狗: '犬', 豬: '豕' };

const countByAnimal = new Map<string, number>(ANIMALS.map((a) => [a, 0]));
let themeCount = 0;
for (const i of issues) {
  if (i.data.zodiac) {
    countByAnimal.set(i.data.zodiac.animal, (countByAnimal.get(i.data.zodiac.animal) ?? 0) + 1);
  } else {
    themeCount += 1;
  }
}
// 各發行地:套數與開始發行年份(用 issue_date 年份,對主題票/金銀條目亦適用)。
type RegionStat = { name: string; count: number; first: number };
const regionMap = new Map<string, RegionStat>();
for (const i of issues) {
  const { code, name } = i.data.region;
  const year = Number(i.data.issue_date.slice(0, 4));
  const r = regionMap.get(code) ?? { name, count: 0, first: year };
  r.count += 1;
  r.first = Math.min(r.first, year);
  regionMap.set(code, r);
}
const regions = [...regionMap.entries()];
---

<Base title="郵票目錄 — 方寸裡的生肖">
  <div class="cat container">
    <header class="cat-head">
      <div class="rule-double"></div>
      <h1>郵票目錄</h1>
      <p class="cat-sub">共收錄 {issues.length} 套 · 依生肖、發行地、年份檢索</p>
      <div class="rule-double"></div>
    </header>

    <section class="block" id="zodiac">
      <h2 class="block-title"><span class="num">壹</span> 按生肖</h2>
      <div class="zodiac-grid">
        {ANIMALS.map((a) => (
          <a class="zcell" href={`${base}/catalog/zodiac/${a}/`}>
            <span class="zseal" style={`--seal:url('${base}/img/seal/${SEAL_CHAR[a] ?? a}.svg')`} role="img" aria-label={a}></span>
            <span class="zbranch">{ANIMAL_BRANCH[a]}</span>
            <span class="zcount">{countByAnimal.get(a)} 套</span>
          </a>
        ))}
        {themeCount > 0 && (
          <a class="zcell zcell-theme" href={`${base}/catalog/zodiac/${THEME_KEY}/`}>
            <span class="zseal" style={`--seal:url('${base}/img/seal/全.svg')`} role="img" aria-label="全"></span>
            <span class="zbranch">主題</span>
            <span class="zcount">{themeCount} 套</span>
          </a>
        )}
      </div>
    </section>

    <section class="block" id="region">
      <h2 class="block-title"><span class="num">貳</span> 按發行地</h2>
      <div class="region-list">
        {regions.map(([code, r]) => (
          <a class="ritem" href={`${base}/catalog/region/${code}/`}>
            <span class="rname">{r.name}<span class="rcode">{code}</span></span>
            <span class="rmeta">
              {r.first}<span class="runit">起</span>・{r.count}<span class="runit">套</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <section class="block" id="timeline">
      <h2 class="block-title"><span class="num">參</span> 按年份</h2>
      <a class="tl-link" href={`${base}/catalog/timeline/`}>檢視發行時間軸 →</a>
    </section>
  </div>
</Base>

<style>
  .cat { padding-bottom: 2rem; }
  .cat-head { padding: 2.5rem 0 0; text-align: center; }
  .cat-head h1 { font-size: clamp(2.2rem, 5vw, 3.2rem); letter-spacing: 0.1em; margin: 1.25rem 0; }
  .cat-sub { color: var(--color-ink-soft); margin-bottom: 1.25rem; }

  .block { margin-top: 3rem; }
  .block-title {
    font-size: 1.3rem;
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 0.6rem;
    margin-bottom: 1.5rem;
  }
  .block-title .num { color: var(--color-gold); margin-right: 0.4rem; }

  .zodiac-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.75rem;
  }
  @media (max-width: 640px) { .zodiac-grid { grid-template-columns: repeat(4, 1fr); } }
  .zcell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    padding: 1rem 0.5rem;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    color: var(--color-ink);
  }
  .zcell:hover { text-decoration: none; border-color: var(--color-gold); background: #fff; }
  /* 篆書(說文解字小篆)以 mask 上色,沿用朱紅;主題格用金色 */
  .zseal {
    display: inline-block;
    width: 2.4rem;
    height: 2.4rem;
    background-color: var(--color-red);
    -webkit-mask: var(--seal) center / contain no-repeat;
    mask: var(--seal) center / contain no-repeat;
  }
  .zcell-theme .zseal { background-color: var(--color-gold); }
  .zbranch { font-family: var(--font-serif); font-size: 0.85rem; color: var(--color-ink-soft); }
  .zcount { font-size: 0.78rem; color: var(--color-ink-soft); margin-top: 0.2rem; }

  .region-list { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .ritem {
    display: inline-flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    color: var(--color-ink);
    font-family: var(--font-serif);
  }
  .ritem:hover { text-decoration: none; border-color: var(--color-gold); }
  .rname { display: inline-flex; align-items: baseline; gap: 0.4rem; }
  .rcode { font-family: var(--font-sans); font-size: 0.72rem; color: var(--color-gold); letter-spacing: 0.05em; }
  .rmeta { font-family: var(--font-sans); font-size: 0.72rem; color: var(--color-ink-soft); }
  .runit { font-size: 0.6rem; margin: 0 0.15em; }

  .tl-link { font-family: var(--font-serif); font-size: 1.1rem; }
</style>
