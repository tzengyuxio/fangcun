---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Gallery from '../../../components/Gallery.astro';
import { year, ganzhi, imgSrc, fallbackSrc, THEME_KEY, THEME_LABEL } from '../../../lib/catalog';

export async function getStaticPaths() {
  const issues = await getCollection('catalog');
  return issues.map((issue) => ({ params: { id: issue.id }, props: { issue } }));
}

const { issue } = Astro.props;
const d = issue.data;
const base = import.meta.env.BASE_URL;

const allSources = await getCollection('sources');
const srcMap = new Map(allSources.map((s) => [s.id, s.data]));

const offsetYear = d.zodiac_year != null && d.zodiac_year !== Number(year(d.issue_date));
const name = d.series_name || (d.zodiac ? `${d.zodiac.animal}年生肖郵票` : THEME_LABEL);

const fallback = fallbackSrc(base);
// 圖庫:套圖 images[] 與各品項圖去重,解析 base;空則用 fallback。
const galleryImgs = [...new Set([...(d.images ?? []), ...d.items.map((it) => it.image)].filter(Boolean))]
  .map((s) => imgSrc(s, base) as string);
const galleryFinal = galleryImgs.length ? galleryImgs : [fallback];

const ITEM_TYPE: Record<string, string> = {
  stamp: '郵票',
  souvenir_sheet: '小全張',
  miniature_sheet: '小型張',
};

const specs = [
  ['系列', d.series_name],
  ['輪次', d.zodiac ? `第 ${d.round} 輪` : null],
  ['在地編號', d.catalog_number?.local],
  ['Scott 編號', d.catalog_number?.scott],
  ['設計者', d.designer],
  ['印製', d.printer],
  ['印法', d.printing_process],
  ['齒孔', d.perforation],
].filter(([, v]) => v) as [string, string][];
---

<Base title={`${name} — 方寸裡的生肖`}>
  <article class="issue container">
    <nav class="crumb">
      <a href={`${base}/catalog/`}>目錄</a> ／
      <a href={`${base}/catalog/region/${d.region.code}/`}>{d.region.name}</a> ／
      {d.zodiac
        ? <a href={`${base}/catalog/zodiac/${d.zodiac.animal}/`}>{d.zodiac.animal}年</a>
        : <a href={`${base}/catalog/zodiac/${THEME_KEY}/`}>{THEME_LABEL}</a>}
    </nav>

    <header class="issue-head">
      <h1>{name}</h1>
      {d.zodiac
        ? <p class="issue-meta">{d.region.name} · 第 {d.round} 輪 · <span class="meta-zodiac">{d.zodiac.animal}（{d.zodiac.branch}）</span></p>
        : <p class="issue-meta">{d.region.name} · <span class="meta-zodiac">{THEME_LABEL}</span></p>}
    </header>

    <div class="issue-body">
      <div class="issue-visual">
        <Gallery
          images={galleryFinal}
          alt={`${name}（${d.region.name}）`}
          regionName={d.region.name}
          regionCode={d.region.code}
          date={year(d.issue_date)}
          fallback={fallback}
        />
        <span class={`vbadge ${d.verified ? 'ok' : 'no'}`}>
          {d.verified ? '✓ 已查證' : '⚠ 未經查證'}
        </span>
      </div>

      <div class="issue-data">
        <!-- D5:發行日與生肖年並列,永不混用 -->
        <div class="d5">
          <div class="d5-cell">
            <span class="d5-label">發行日</span>
            <span class="d5-val">{d.issue_date}</span>
          </div>
          <div class="d5-cell">
            <span class="d5-label">生肖年</span>
            <span class="d5-val">{d.zodiac_year != null ? `${d.zodiac_year}（${ganzhi(d.zodiac_year)}）` : '—'}</span>
          </div>
        </div>
        {offsetYear && (
          <p class="d5-note">※ 賀歲票常於生肖年前一年底發行,故發行年與生肖年相差一年。</p>
        )}
        {!d.zodiac && (
          <p class="d5-note">※ 全 12 生肖／主題票,不對應單一生肖年。</p>
        )}

        {specs.length > 0 && (
          <dl class="spec">
            {specs.map(([k, v]) => (
              <div class="spec-row">
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))}
          </dl>
        )}

        {d.significance && <p class="significance">{d.significance}</p>}
        {d.notes && <p class="notes">{d.notes}</p>}
      </div>
    </div>

    <section class="sect">
      <h2>品項（{d.items.length}）</h2>
      <ul class="items">
        {d.items.map((it) => (
          <li class="item">
            <span class="item-type">{ITEM_TYPE[it.type] ?? it.type}</span>
            <span class="item-detail">
              {it.description && <strong>{it.description}</strong>}
              {it.denomination?.value != null && ` · 面值 ${it.denomination.value} ${it.denomination.currency}`}
              {it.dimensions_mm && ` · ${it.dimensions_mm.w}×${it.dimensions_mm.h} mm`}
              {it.mintage != null && ` · 發行量 ${it.mintage.toLocaleString()}`}
            </span>
          </li>
        ))}
      </ul>
    </section>

    <section class="sect">
      <h2>外部連結</h2>
      <ul class="sources">
        {d.sources.map((s) => {
          const meta = srcMap.get(s.ref.id);
          const href = s.url ?? meta?.url;
          return (
            <li class="source">
              {s.tier === 'official' && (
                <span class="tier tier-official" data-tip="來自發行單位的官方資訊">官方</span>
              )}
              {meta && href ? <a href={href} target="_blank" rel="noopener">{meta.title}</a> : <span class="missing">{s.ref.id}</span>}
            </li>
          );
        })}
      </ul>
      <p class="updated">最後更新:{d.updated_at}</p>
    </section>
  </article>
</Base>

<style>
  .issue { padding: 2rem 1.5rem 3rem; max-width: 880px; }
  .crumb { font-size: 0.85rem; color: var(--color-ink-soft); margin-bottom: 1.5rem; }

  .issue-head { border-bottom: 1px solid var(--color-line); padding-bottom: 1.25rem; }
  .issue-head h1 { font-size: clamp(1.8rem, 5vw, 2.8rem); letter-spacing: 0.05em; }
  .issue-meta { margin-top: 0.5rem; font-size: 0.95rem; color: var(--color-ink-soft); }
  .meta-zodiac { font-family: var(--font-serif); color: var(--color-red); }

  .issue-body {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 2.5rem;
    margin-top: 2rem;
  }
  @media (max-width: 640px) { .issue-body { grid-template-columns: 1fr; } }

  .issue-visual { text-align: center; }
  .vbadge {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.3rem 0.9rem;
    font-size: 0.85rem;
    border-radius: 2px;
    border: 1px solid;
  }
  .vbadge.ok { color: #2f6b3a; border-color: #2f6b3a; background: rgba(47, 107, 58, 0.08); }
  .vbadge.no { color: var(--color-red); border-color: var(--color-red); background: rgba(158, 43, 37, 0.07); }

  /* D5 強調區 */
  .d5 { display: flex; gap: 0; border: 1px solid var(--color-line); }
  .d5-cell { flex: 1; padding: 0.9rem 1.1rem; }
  .d5-cell + .d5-cell { border-left: 1px solid var(--color-line); }
  .d5-label { display: block; font-size: 0.75rem; letter-spacing: 0.1em; color: var(--color-gold); margin-bottom: 0.25rem; }
  .d5-val { font-family: var(--font-serif); font-size: 1.25rem; color: var(--color-ink); }
  .d5-note { font-size: 0.82rem; color: var(--color-ink-soft); margin-top: 0.5rem; }

  .spec { margin-top: 1.5rem; }
  .spec-row { display: flex; border-bottom: 1px solid var(--color-line); padding: 0.5rem 0; }
  .spec-row dt { width: 6.5rem; flex-shrink: 0; color: var(--color-ink-soft); font-size: 0.9rem; }
  .spec-row dd { font-size: 0.95rem; }

  .significance {
    margin-top: 1.5rem;
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--color-red);
    border-left: 3px solid var(--color-gold);
    padding-left: 0.9rem;
  }
  .notes { margin-top: 1rem; color: var(--color-ink-soft); font-size: 0.95rem; }

  .sect { margin-top: 2.5rem; }
  .sect h2 { font-size: 1.3rem; border-bottom: 1px solid var(--color-line); padding-bottom: 0.5rem; margin-bottom: 1rem; }

  .items, .sources { list-style: none; }
  .item { display: flex; gap: 0.9rem; padding: 0.5rem 0; align-items: baseline; }
  .item-type {
    flex-shrink: 0;
    font-family: var(--font-serif);
    font-size: 0.82rem;
    color: var(--color-gold);
    border: 1px solid var(--color-line);
    padding: 0.1rem 0.5rem;
  }
  .item-detail { font-size: 0.95rem; }

  .source { display: flex; gap: 0.75rem; align-items: baseline; padding: 0.45rem 0; }
  .tier {
    flex-shrink: 0;
    font-size: 0.75rem;
    padding: 0.12rem 0.55rem;
    border-radius: 2px;
    font-family: var(--font-sans);
  }
  .tier-official { position: relative; background: #2f6b3a; color: #fff; cursor: help; }
  /* 即時 hover tooltip(取代有延遲的原生 title) */
  .tier-official::after {
    content: attr(data-tip);
    position: absolute;
    bottom: calc(100% + 6px);
    left: 0;
    background: var(--color-ink);
    color: var(--color-bg);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    padding: 0.3rem 0.55rem;
    border-radius: 2px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.1s ease;
    z-index: 5;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
  }
  .tier-official:hover::after { opacity: 1; }
  .missing { color: var(--color-red); }
  .updated { margin-top: 1rem; font-size: 0.8rem; color: var(--color-ink-soft); }
</style>
