---
import Base from '../../../layouts/Base.astro';
import StampCard from '../../../components/StampCard.astro';
import { ANIMALS, ANIMAL_BRANCH, THEME_KEY, THEME_LABEL, byIssueDate, getVisibleCatalog } from '../../../lib/catalog';

export async function getStaticPaths() {
  const all = await getVisibleCatalog();
  const paths = ANIMALS.map((animal) => ({
    params: { animal },
    props: { issues: all.filter((i) => i.data.zodiac?.animal === animal).sort(byIssueDate), isTheme: false },
  }));
  const theme = all.filter((i) => !i.data.zodiac).sort(byIssueDate);
  if (theme.length) {
    paths.push({ params: { animal: THEME_KEY }, props: { issues: theme, isTheme: true } });
  }
  return paths;
}

const { animal } = Astro.params;
const { issues, isTheme } = Astro.props;
const branch = isTheme ? null : ANIMAL_BRANCH[animal as string];
---

<Base title={`${isTheme ? THEME_LABEL : `${animal}年生肖郵票`} — 方寸裡的生肖`}>
  <div class="zpage container">
    <header class="zhead">
      <div class="rule-double"></div>
      <p class="zkicker">按生肖</p>
      {isTheme
        ? <h1>{THEME_LABEL}<span class="branch">主題票</span></h1>
        : <h1>{animal}<span class="branch">（{branch}）</span></h1>}
      <p class="zsub">{isTheme ? `${issues.length} 套 · 不對應單一生肖年的全 12 生肖／主題票` : `${issues.length} 套收錄`}</p>
      <div class="rule-double"></div>
    </header>

    {issues.length > 0 ? (
      <div class="album-grid">{issues.map((i) => <StampCard issue={i} />)}</div>
    ) : (
      <p class="empty">🚧 此生肖尚無收錄,陸續上線。</p>
    )}
  </div>
</Base>

<style>
  .zpage { padding-bottom: 3rem; }
  .zhead { text-align: center; padding: 2.5rem 0 0; }
  .zkicker { font-size: 0.78rem; letter-spacing: 0.25em; color: var(--color-gold); margin-bottom: 0.6rem; }
  .zhead h1 { font-size: clamp(3rem, 8vw, 5rem); color: var(--color-red); margin: 0.5rem 0; }
  .branch { font-size: 0.4em; color: var(--color-ink-soft); }
  .zsub { color: var(--color-ink-soft); margin-bottom: 1.25rem; }
  .empty { text-align: center; color: var(--color-ink-soft); padding: 3rem 0; }
</style>
