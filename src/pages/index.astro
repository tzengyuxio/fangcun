---
import Base from '../layouts/Base.astro';
import Postmark from '../components/Postmark.astro';
import StampCard from '../components/StampCard.astro';
import { getVisibleCatalog, primaryImage } from '../lib/catalog';

const base = import.meta.env.BASE_URL;

const issues = await getVisibleCatalog();
const regionCount = new Set(issues.map((i) => i.data.region.code)).size;
const years = issues.map((i) => Number(i.data.issue_date.slice(0, 4)));
const yearRange = years.length ? `${Math.min(...years)}–${Math.max(...years)}` : '';
const mastheadMeta = [
  `涵蓋 ${regionCount} 個郵政`,
  `${issues.length} 套發行`,
  yearRange,
  '來源分級可考',
].filter(Boolean).join(' · ');

// 精選候選池:已查證且有真圖的套票。前端隨機挑 3 套展示(資料驅動,隨 verified 自動擴大)。
const featured = issues.filter((i) => primaryImage(i.data));

const axes = [
  { num: '壹', title: '按生肖', desc: '鼠牛虎兔龍蛇馬羊猴雞狗豬 — 依十二地支歸類，跨郵政對照同一生肖。', href: `${base}/catalog/#zodiac` },
  { num: '貳', title: '按發行地', desc: '台、中、港、澳、日、韓、美、越、蒙、法、泰、加… 各郵政的生肖票系譜。', href: `${base}/catalog/#region` },
  { num: '參', title: '按年份', desc: '依實際發行日排成時間軸，從 1950 年世界首套到最新一輪。', href: `${base}/catalog/#timeline` },
];
---

<Base title="方寸裡的生肖 — 生肖郵票科普／參考站">
  <header class="masthead container">
    <div class="rule-double"></div>
    <div class="masthead-body">
      <div class="masthead-text">
        <p class="masthead-kicker">世界生肖郵票總覽 · A Reference of Zodiac Stamps</p>
        <h1 class="masthead-title">方寸裡的生肖</h1>
        <p class="masthead-meta">{mastheadMeta}</p>
      </div>
      <div class="masthead-mark">
        <Postmark top="方寸生肖" date="參考" bottom="REFERENCE" rotate={-8} />
      </div>
    </div>
    <div class="rule-double"></div>
  </header>

  {featured.length > 0 && (
    <section class="album container" aria-label="精選郵票">
      <div class="album-grid" id="featured-grid">
        {featured.map((i) => <StampCard issue={i} />)}
      </div>
    </section>
  )}

  <nav class="axis container" aria-label="三軸索引">
    {axes.map((a) => (
      <a class="axis-col" href={a.href}>
        <span class="axis-num">{a.num}</span>
        <h2>{a.title}</h2>
        <p>{a.desc}</p>
      </a>
    ))}
  </nav>

  <p class="status container">🚧 建置中 — 已收錄 {issues.length} 套、{regionCount} 個郵政;更多郵政與郵票圖陸續上線。</p>
</Base>

<script>
  // 精選區:從候選卡隨機挑 3 張顯示(每次載入換組)。無 JS 時 CSS 顯示前 3。
  const grid = document.getElementById('featured-grid');
  if (grid) {
    const cards = Array.from(grid.children) as HTMLElement[];
    const SHOW = 3;
    if (cards.length > SHOW) {
      for (let i = cards.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [cards[i], cards[j]] = [cards[j], cards[i]];
      }
      cards.forEach((c, idx) => {
        c.style.display = idx < SHOW ? 'block' : 'none';
      });
    }
  }
</script>

<style>
  /* Masthead — 目錄刊頭(取代置中 hero) */
  .masthead {
    padding: 2.75rem 1.5rem 0;
  }
  .rule-double {
    border-top: 3px double var(--color-ink);
  }
  .masthead-body {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.5rem 0;
  }
  .masthead-kicker {
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    color: var(--color-gold);
    margin-bottom: 0.6rem;
  }
  .masthead-title {
    font-size: clamp(2.8rem, 7vw, 5rem);
    font-weight: 900;
    letter-spacing: 0.12em;
    line-height: 1.05;
  }
  .masthead-meta {
    margin-top: 0.85rem;
    color: var(--color-ink-soft);
    font-size: 0.95rem;
  }
  .masthead-mark {
    flex-shrink: 0;
    width: 100px;
    height: 100px;
  }
  @media (max-width: 640px) {
    .masthead-mark { display: none; }
  }

  /* Album — 護郵冊展櫃(深底格線);精選卡複用 StampCard */
  .album {
    margin-top: 3rem;
  }
  /* .album-grid 樣式已移至 global.css(首頁與目錄共用) */
  /* 無 JS fallback:只顯示前 3 張;載入後由 script 隨機挑 3 換組 */
  #featured-grid :global(.card:nth-child(n + 4)) {
    display: none;
  }

  /* Axis — 目錄條目式三軸入口 */
  .axis {
    margin-top: 3.5rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--color-line);
  }
  .axis-col {
    display: block;
    padding: 1.75rem 1.4rem;
    border-left: 1px solid var(--color-line);
    color: var(--color-ink);
  }
  .axis-col:first-child {
    border-left: none;
  }
  .axis-col:hover {
    background: rgba(176, 141, 87, 0.08);
    text-decoration: none;
  }
  .axis-num {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-gold);
  }
  .axis-col h2 {
    font-size: 1.2rem;
    margin: 0.3rem 0 0.5rem;
  }
  .axis-col p {
    font-size: 0.9rem;
    color: var(--color-ink-soft);
  }
  @media (max-width: 640px) {
    .axis { grid-template-columns: 1fr; }
    .axis-col { border-left: none; border-top: 1px solid var(--color-line); }
    .axis-col:first-child { border-top: none; }
  }

  .status {
    text-align: center;
    color: var(--color-ink-soft);
    font-size: 0.92rem;
    margin: 2.75rem auto;
    max-width: 720px;
  }
</style>
