---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** OG 類型:內容頁(詳情/專題)傳 'article',其餘預設 'website'。 */
  ogType?: 'website' | 'article';
  /** OG 預覽圖(站內路徑,含 base)。郵票真圖不納版控、Pages 上會 404,故預設用納版控的 og-default.png。 */
  ogImage?: string;
}
const {
  title,
  description = '方寸裡的生肖 — 涵蓋各郵政發行生肖郵票的科普／參考站',
  ogType = 'website',
  ogImage,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const pageTitle = title.includes('方寸裡的生肖') ? title : `${title} | 方寸裡的生肖`;
// OG 需要絕對網址(site 設定於 astro.config)。
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImageAbs = Astro.site
  ? new URL(ogImage ?? `${base}/img/og-default.png`, Astro.site).href
  : undefined;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content="方寸裡的生肖" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImageAbs && <meta property="og:image" content={ogImageAbs} />}
    {ogImageAbs && <meta property="og:image:width" content="1200" />}
    {ogImageAbs && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImageAbs && <meta name="twitter:image" content={ogImageAbs} />}
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@500;700;900&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <nav class="site-nav">
      <div class="nav-inner">
        <a class="nav-logo" href={`${base}/`}>方寸裡的生肖</a>
        <ul class="nav-links">
          <li><a href={`${base}/`}>首頁</a></li>
          <li><a href={`${base}/catalog/`}>目錄</a></li>
          <li><a href={`${base}/about/`}>認識生肖郵票</a></li>
          <li><a href={`${base}/about-site/`}>關於本站</a></li>
        </ul>
      </div>
    </nav>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p class="footer-brand">
          <span class="seal">肖</span>
          <span class="footer-title">方寸裡的生肖 · 生肖郵票科普／參考站</span>
        </p>
        <p class="footer-copy">© 2026 方寸裡的生肖 ｜ 本站引用之郵票圖片版權歸各發行郵政機構所有</p>
      </div>
    </footer>
  </body>
</html>
