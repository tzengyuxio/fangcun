---
// Circular date-stamp (郵戳) rendered purely as inline SVG — arc text + double ring.
interface Props {
  top?: string;
  date?: string;
  bottom?: string;
  rotate?: number;
}
const { top = '中華郵政', date = '57.11.12', bottom = 'TAIPEI', rotate = -13 } = Astro.props;
// unique ids so multiple postmarks on one page don't collide (build-time)
const uid = Math.random().toString(36).slice(2, 8);
---

<svg class="postmark" viewBox="0 0 100 100" style={`--rot:${rotate}deg`} aria-hidden="true">
  <defs>
    <path id={`t-${uid}`} d="M 22,50 A 28,28 0 0 1 78,50" />
    <path id={`b-${uid}`} d="M 24,53 A 26,26 0 0 0 76,53" />
  </defs>
  <circle cx="50" cy="50" r="47" />
  <circle cx="50" cy="50" r="39" stroke-width="0.8" />
  <text class="pm-arc"><textPath href={`#t-${uid}`} startOffset="50%">{top}</textPath></text>
  <text class="pm-arc pm-bot"><textPath href={`#b-${uid}`} startOffset="50%">{bottom}</textPath></text>
  <line x1="32" y1="50" x2="68" y2="50" stroke-width="0.8" />
  <text class="pm-date" x="50" y="48">{date}</text>
</svg>

<style>
  .postmark {
    width: 100%;
    height: 100%;
    transform: rotate(var(--rot));
    opacity: 0.55;
    mix-blend-mode: multiply;
  }
  .postmark circle,
  .postmark line {
    fill: none;
    stroke: #1f1b16;
    stroke-width: 1.6;
  }
  .pm-arc {
    fill: #1f1b16;
    font-family: var(--font-serif);
    font-size: 8px;
    letter-spacing: 1px;
  }
  .pm-bot {
    font-size: 6px;
    letter-spacing: 2px;
  }
  .pm-date {
    fill: #1f1b16;
    font-family: var(--font-serif);
    font-size: 9px;
    text-anchor: middle;
    dominant-baseline: middle;
  }
</style>
