---
// 詳情頁圖庫:郵票框主圖 + 縮圖列點擊切換 + 點主圖 lightbox 放大(可左右切換上下張)。
import Postmark from './Postmark.astro';

interface Props {
  images: string[]; // 已解析好 base 的可用 src
  alt: string;
  regionName: string;
  regionCode: string;
  date: string;
  fallback: string;
}
const { images, alt, regionName, regionCode, date, fallback } = Astro.props;
const main = images[0] ?? fallback;
const multi = images.length > 1;
---

<div class="gallery">
  <div class="stamp-wrap big-wrap">
    <div class="stamp big">
      <img
        id="gal-main"
        class="stamp-photo"
        src={main}
        alt={alt}
        data-fallback={fallback}
        onerror="this.onerror=null;this.src=this.dataset.fallback"
      />
    </div>
    <div class="stamp-mark">
      <Postmark top={regionName} date={date} bottom={regionCode} rotate={-24} />
    </div>
  </div>

  {multi && (
    <div class="gthumbs">
      {images.map((src, i) => (
        <button class:list={['gthumb', { active: i === 0 }]} type="button" data-src={src} aria-label={`第 ${i + 1} 張`}>
          <img src={src} alt="" loading="lazy" data-fallback={fallback} onerror="this.onerror=null;this.src=this.dataset.fallback" />
        </button>
      ))}
    </div>
  )}
</div>

<div class="lightbox" id="lightbox" hidden>
  <div class="lb-stage">
    <button class="lb-btn lb-prev" id="lb-prev" type="button" aria-label="上一張" hidden>‹</button>
    <img id="lb-img" src="" alt={alt} />
    <button class="lb-btn lb-next" id="lb-next" type="button" aria-label="下一張" hidden>›</button>
    <span class="lb-count" id="lb-count" hidden></span>
  </div>
</div>

<script>
  const main = document.getElementById('gal-main') as HTMLImageElement | null;
  const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>('.gthumb'));
  const lb = document.getElementById('lightbox');
  const lbImg = document.getElementById('lb-img') as HTMLImageElement | null;
  const prevBtn = document.getElementById('lb-prev');
  const nextBtn = document.getElementById('lb-next');
  const count = document.getElementById('lb-count');

  // 完整有序圖列:多圖取縮圖 data-src,單圖取主圖。
  const imgs = thumbs.length
    ? thumbs.map((t) => t.dataset.src || '').filter(Boolean)
    : main
      ? [main.src]
      : [];
  const multi = imgs.length > 1;
  let idx = 0;

  const setMain = (i: number) => {
    idx = i;
    if (main) main.src = imgs[i];
    thumbs.forEach((x, j) => x.classList.toggle('active', j === i));
  };
  const renderLb = () => {
    if (lbImg) lbImg.src = imgs[idx];
    if (prevBtn) prevBtn.hidden = !multi;
    if (nextBtn) nextBtn.hidden = !multi;
    if (count) {
      count.hidden = !multi;
      count.textContent = `${idx + 1} / ${imgs.length}`;
    }
  };
  const nav = (d: number) => {
    idx = (idx + d + imgs.length) % imgs.length;
    setMain(idx);
    renderLb();
  };
  const open = () => {
    if (!lb || !imgs.length) return;
    renderLb();
    lb.hidden = false;
    document.body.style.overflow = 'hidden';
  };
  const close = () => {
    if (lb) lb.hidden = true;
    document.body.style.overflow = '';
  };

  thumbs.forEach((t, i) => t.addEventListener('click', () => setMain(i)));
  main?.addEventListener('click', open);
  prevBtn?.addEventListener('click', (e) => { e.stopPropagation(); nav(-1); });
  nextBtn?.addEventListener('click', (e) => { e.stopPropagation(); nav(1); });
  lbImg?.addEventListener('click', (e) => { e.stopPropagation(); if (multi) nav(1); else close(); });
  lb?.addEventListener('click', close);
  document.addEventListener('keydown', (e) => {
    if (lb?.hidden) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowLeft' && multi) nav(-1);
    else if (e.key === 'ArrowRight' && multi) nav(1);
  });
</script>

<style>
  .gallery { width: 200px; margin: 0 auto; }
  .big-wrap { width: 200px; }
  .stamp.big { width: 100%; }
  /* 依郵票本身比例呈現(目錄頁仍用統一票框) */
  .stamp.big .stamp-photo { aspect-ratio: auto; cursor: zoom-in; }

  .gthumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: center;
    margin-top: 0.9rem;
  }
  .gthumb {
    width: 46px;
    height: 46px;
    padding: 2px;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  .gthumb:hover { border-color: var(--color-gold); }
  .gthumb.active { border-color: var(--color-red); }
  .gthumb img { width: 100%; height: 100%; object-fit: contain; display: block; }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4vmin;
    background: rgba(20, 16, 12, 0.9);
    cursor: zoom-out;
  }
  .lightbox[hidden] { display: none; }
  /* 圖片容器:箭頭與計數相對它定位(貼圖片兩側,不再貼 viewport) */
  .lb-stage { position: relative; }
  .lightbox img {
    max-width: min(88vw, calc(100vw - 9rem));
    max-height: 88vh;
    object-fit: contain;
    box-shadow: 0 10px 50px rgba(0, 0, 0, 0.6);
    cursor: default;
    display: block;
  }

  /* 左右切換鈕:貼在圖片外緣兩側 */
  .lb-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 3rem;
    height: 4.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.6rem;
    line-height: 1;
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
    border: none;
    cursor: pointer;
    transition: background 0.15s ease;
    user-select: none;
  }
  .lb-btn:hover { background: rgba(255, 255, 255, 0.2); }
  .lb-btn[hidden] { display: none; }
  .lb-prev { right: 100%; margin-right: 0.6rem; }
  .lb-next { left: 100%; margin-left: 0.6rem; }
  /* 窄螢幕圖片可佔滿寬,箭頭改貼圖片內緣 */
  @media (max-width: 640px) {
    .lightbox img { max-width: 92vw; }
    .lb-prev { right: auto; left: 0; margin-right: 0; }
    .lb-next { left: auto; right: 0; margin-left: 0; }
  }

  .lb-count {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    margin-top: 0.7rem;
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    white-space: nowrap;
  }
  .lb-count[hidden] { display: none; }
</style>
